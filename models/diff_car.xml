<mujoco model="diff_car">
  <!-- 差速小车：底盘（freejoint 平面运动）+ 两驱动轮（hinge + velocity 执行器）
       + 前后滚珠（被动、低摩擦）。纯机器人模型：地面/灯光/物体由世界 YAML 提供。
       驱动约定：ctrl +10 -> 前进 +x（两轮同向），左右轮差速转向。 -->
  <compiler angle="radian"/>
  <option timestep="0.002"/>

  <worldbody>
    <body name="car" pos="0 0 0.045">
      <joint name="car_free" type="free"/>
      <geom name="car_geom" type="box" size="0.09 0.05 0.017" rgba="0.2 0.6 0.6 1"/>

      <body name="wheel_l" pos="0 0.06 -0.013">
        <joint name="wl" type="hinge" axis="0 1 0"/>
        <geom name="wheel_l_geom" type="cylinder" size="0.032 0.008"
              euler="1.5708 0 0" rgba="0.3 0.3 0.35 1"/>
      </body>
      <body name="wheel_r" pos="0 -0.06 -0.013">
        <joint name="wr" type="hinge" axis="0 1 0"/>
        <geom name="wheel_r_geom" type="cylinder" size="0.032 0.008"
              euler="1.5708 0 0" rgba="0.3 0.3 0.35 1"/>
      </body>
      <body name="castor_f" pos="0.08 0 -0.028">
        <geom name="castor_f_geom" type="sphere" size="0.017"
              rgba="0.5 0.5 0.55 1" friction="0.02 0.001 0.0001"/>
      </body>
      <body name="castor_b" pos="-0.08 0 -0.028">
        <geom name="castor_b_geom" type="sphere" size="0.017"
              rgba="0.5 0.5 0.55 1" friction="0.02 0.001 0.0001"/>
      </body>
    </body>
  </worldbody>

  <actuator>
    <velocity name="w_l" joint="wl" kv="6" ctrlrange="-10 10"/>
    <velocity name="w_r" joint="wr" kv="6" ctrlrange="-10 10"/>
  </actuator>
</mujoco>
